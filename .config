# 目标平台选择
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_PROFILE="DEVICE_bananapi_bpi-r4"
CONFIG_TARGET_ROOTFS_PARTSIZE=796

# 自定义编译选项
# 启用多语言支持
CONFIG_BUILD_NLS=y

# 自定义内核功能
#CONFIG_TESTING_KERNEL=y
# dae 内核配置
CONFIG_DEVEL=y
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
# qt6 内核配置
CONFIG_KERNEL_IO_URING=y

# 内置软件包（对齐 immortalwrt 13376a7 源码里的设备默认包集）
#
# 来源（改动前请对照这几处，包名必须与源码里的名字逐字一致）：
#   include/target.mk          DEFAULT_PACKAGES + DEFAULT_PACKAGES.router（DEVICE_TYPE?=router）
#   target/linux/mediatek/Makefile、target/linux/mediatek/filogic/target.mk   板级/子目标的 DEFAULT_PACKAGES 追加
#   target/linux/mediatek/image/filogic.mk   Device/bananapi_bpi-r4-common 的 DEVICE_PACKAGES
#
# 两处刻意的替换，不要改回默认值：
#   dropbear → openssh-server（SSH），见本段末尾「默认集之外的替换与追加」
#   uhttpd   → nginx-ssl（Web 服务；LuCI 侧由「自定义软件包」里的 luci-nginx / luci-app-nginx 接管）
#   两者的默认包已在文件末尾「明确关闭的软件包」段显式关闭。

# —— include/target.mk：DEFAULT_PACKAGES（基础集，dropbear 已替换为 openssh）——
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

# —— include/target.mk：DEFAULT_PACKAGES.router（DEVICE_TYPE 默认 router）——
# 注意：源码里写的是构建系统名 nftables，它由 nftables-json 提供；
# kconfig 只认真实包名，写成 CONFIG_PACKAGE_nftables=y 会被 defconfig 静默丢弃。
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# —— target/linux/mediatek/Makefile + filogic/target.mk：板级与子目标追加 ——
CONFIG_PACKAGE_bridger=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_wpad-openssl=y

# —— filogic.mk：Device/bananapi_bpi-r4-common 的 DEVICE_PACKAGES ——
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_kmod-eeprom-at24=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-i2c-mux-pca954x=y
CONFIG_PACKAGE_kmod-mt7996-233-firmware=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-phy-aquantia=y
CONFIG_PACKAGE_kmod-rtc-pcf8563=y
CONFIG_PACKAGE_kmod-sfp=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_mt7988-wo-firmware=y

# —— 默认集之外的替换与追加 ——
# ssh：替换 dropbear
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-client=y
CONFIG_PACKAGE_openssh-sftp-server=y
# web：替换 uhttpd（luci-nginx 依赖 nginx-ssl-util，实际装进固件的是 nginx-ssl）
CONFIG_PACKAGE_nginx-ssl=y
# 包管理器与隔离机制：kconfig 缺省即 y，显式写出以免默认值变化时静默丢失
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_procd-ujail=y
# MT7988 的 crypto offload，上游默认集里没有，但本板需要
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y

# 中文语言包
CONFIG_PACKAGE_default-settings-chn=y

# 自定义软件包
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_bpi-r4-pwm-fan=m
CONFIG_PACKAGE_dockerd=m
CONFIG_PACKAGE_fan2go=m
CONFIG_PACKAGE_kmod-netlink-diag=m
CONFIG_PACKAGE_liburing=m
# argon 的配置应用已被上游合并进 luci-theme-argon：主题的 Makefile 里写着
#   LUCI_BASENAME:=argon-config / PKG_PROVIDES:=luci-app-argon-config
# 并自带 htdocs/luci-static/resources/view/argon-config.js 与 /etc/config/argon 的 conffiles。
# 旧包名只以 PROVIDES 形式存在，kconfig 不会生成 CONFIG_PACKAGE_luci-app-argon-config 符号，
# 选中它必被 defconfig 静默丢弃；配置界面随 CONFIG_PACKAGE_luci-theme-argon 一并装出。
#CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-dae=m
CONFIG_PACKAGE_luci-app-diskman=m
CONFIG_PACKAGE_luci-app-easyupdate=m
CONFIG_PACKAGE_luci-app-fancontrol=m
CONFIG_PACKAGE_luci-app-fanxpert=m
CONFIG_PACKAGE_luci-app-lucky=m
CONFIG_PACKAGE_luci-app-nginx=y
CONFIG_PACKAGE_luci-app-openclash=m
CONFIG_PACKAGE_luci-app-qbittorrent-original=m
CONFIG_PACKAGE_luci-app-rtfwupgrade=m
CONFIG_PACKAGE_luci-nginx=y
CONFIG_PACKAGE_luci-theme-argon=y
# 中文 / Emoji 字体（Noto）：以下包为 `=m`，编译进仓库但**不内置**，按需在「系统 → 软件包」安装。
#
# 为什么是模组（=m）而不是内置（=y）：
#   · 体积：三份 CJK 可变字体实测 31.2 MB / 30.4 MB / 54.8 MB，合计约 116 MB；
#     emoji 再加 4.8 MB（Noto-COLRv1.ttf）。全部内置会让固件凭空增重一百多兆，
#     这对 8 GiB eMMC 的板子也不合理。本仓库的定位是「基础组件 + 可选包」，
#     字体属于典型的按需能力，不该占默认体积。
#   · 用途：LuCI 与 argon 主题都不依赖字体包（两者的 Makefile 里没有任何字体 DEPENDS），
#     固件里也没有其它字体包。这些字体的价值在浏览器/终端等客户端渲染场景，
#     比如网页里的中文排版、文档预览、Emoji 显示，属于典型按需启用。
#
# 四个包名都是上游 openwrt/packages 的真实符号，逐一对应一个字体文件：
#   noto-fonts-cjk-sans        NotoSansCJK-VF.otf.ttc       常规无衬线
#   noto-fonts-cjk-sans-mono   NotoSansMonoCJK-VF.otf.ttc   等宽（代码/终端）
#   noto-fonts-cjk-serif       NotoSerifCJK-VF.otf.ttc      衬线（正文排版）
#   noto-fonts-color-emoji     Noto-COLRv1.ttf              Emoji（COLRv1 矢量）
# 四者都 DEPENDS:=+noto-fonts-license（OFL 许可文本单独成包），安装时自动带入，无需手写。
#
# 旧名（noto-fonts-cjk / noto-fonts-emoji）来自已删除的第三方仓库，官方包名与之不同：
# cjk 拆成三个 -sans / -sans-mono / -serif，emoji 带 color-。写错会被 defconfig
# 静默丢弃：不报错、不告警，固件看似正常却没有字体，比「没有这个选项」更难排查。
#
# 旧备份兼容：restore-packages.sh 的对照表会把旧包名自动换成上面的新名，
# 并把拆分的三个 CJK 包全部装回，用户无需手动处理。
CONFIG_PACKAGE_noto-fonts-cjk-sans=m
CONFIG_PACKAGE_noto-fonts-cjk-sans-mono=m
CONFIG_PACKAGE_noto-fonts-cjk-serif=m
CONFIG_PACKAGE_noto-fonts-color-emoji=m
CONFIG_PACKAGE_zram-swap=m

# 明确关闭的软件包
# CONFIG_PACKAGE_dropbear is not set
# CONFIG_PACKAGE_uhttpd is not set
