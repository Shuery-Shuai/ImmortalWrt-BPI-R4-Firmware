#!/bin/sh
#===============================================================================
# Hotplug 触发脚本：WAN 接口上线后自动运行软件包恢复
# 功能：当 OpenWrt 的 WAN 接口获取 IP 或状态变为 up 时，等待网络真正连通，
#       然后调用 restore-packages.sh 按两阶段策略恢复用户软件包。
# 用法：放置于 /etc/hotplug.d/iface/ 目录下，由系统 hotplug 事件自动调用。
#
# 调度层职责（本脚本 = 调度层）：
#   1) 只处理 WAN 的 ifup 事件；
#   2) 开机窗口判断：只有设备刚启动的一段时间内才运行恢复脚本。
#      这就是需求里「时间窗口判断在调度层完成」的落点。
#      因为 ifup 不只在开机时触发，WAN 后续重新拨号/闪断也会触发；
#      若不在调度层拦截，恢复脚本可能在跑到一半时被再次拉起。
#   3) 等待网络就绪后调用恢复脚本。恢复脚本自身不含任何时间判断，
#      手动执行（restore-packages.sh -c）始终立即生效。
#   4) 二次失败终态：恢复脚本以退出码 1 退出且不再重启；
#      本脚本此时只记日志、绝不拉起任何重启，后续交给 LuCI 登录提示。
#
# 配置参数（均可通过同名环境变量覆盖）：
#   LOGGER_TAG      syslog 标签 [默认: restore-packages-hotplug]
#   MAX_WAIT        最长等待网络就绪的时间（秒） [默认: 180]
#   CHECK_INTERVAL  网络检测间隔（秒） [默认: 10]
#   PING_TARGET     用于测试连通性的目标地址 [默认: 8.8.8.8]
#   RESTORE_SCRIPT  恢复脚本路径 [默认: /usr/bin/restore-packages.sh]
#   TRIGGER_LOG     触发过程与恢复脚本的输出日志文件
#                   [默认: /var/log/restore-packages-trigger.log]
#   BOOT_WINDOW     开机窗口（秒）：/proc/uptime 超过该值就不再执行恢复
#                   [默认: 900，即开机 15 分钟内]
#
# 说明：
#   - 整个检测和执行过程在后台子 shell 中运行，不阻塞 hotplug 主进程。
#   - 作者：Shuery-Shuai
#   - 日期：2026-10-28
#   - 版本：2.0.0
#===============================================================================

LOGGER_TAG="${LOGGER_TAG:-restore-packages-hotplug}"
MAX_WAIT="${MAX_WAIT:-180}"
CHECK_INTERVAL="${CHECK_INTERVAL:-10}"
PING_TARGET="${PING_TARGET:-8.8.8.8}"
RESTORE_SCRIPT="${RESTORE_SCRIPT:-/usr/bin/restore-packages.sh}"
TRIGGER_LOG="${TRIGGER_LOG:-/var/log/restore-packages-trigger.log}"
BOOT_WINDOW="${BOOT_WINDOW:-900}"
# 互斥锁路径（可用 LOCKFILE 覆盖，便于测试与只读根文件系统场景）
LOCKFILE="${LOCKFILE:-/var/run/restore-hotplug.lock}"

#===============================================================================
# 事件过滤：仅处理 WAN 接口的 ifup 事件
#===============================================================================
[ "$ACTION" = "ifup" ] && [ "$INTERFACE" = "wan" ] || exit 0

#===============================================================================
# 参数校验：非整数一律回落到默认值，避免后续 [ -lt ] 比较报错
#===============================================================================
case "$MAX_WAIT" in
'' | *[!0-9]*)
    logger -t "$LOGGER_TAG" "警告: MAX_WAIT 值无效，使用默认值 180 秒"
    MAX_WAIT=180
    ;;
esac
case "$CHECK_INTERVAL" in
'' | *[!0-9]* | 0)
    logger -t "$LOGGER_TAG" "警告: CHECK_INTERVAL 值无效，使用默认值 10 秒"
    CHECK_INTERVAL=10
    ;;
esac
case "$BOOT_WINDOW" in
'' | *[!0-9]*)
    logger -t "$LOGGER_TAG" "警告: BOOT_WINDOW 值无效，使用默认值 900 秒"
    BOOT_WINDOW=900
    ;;
esac

#===============================================================================
# 开机窗口判断（调度层的时间窗口）
#   /proc/uptime 第一列是开机至今的秒数（可能带小数）。
#   超过 BOOT_WINDOW 说明这次 ifup 不是开机首连（典型是 WAN 重拨/闪断），
#   直接退出，避免把正在进行的恢复流程重复拉起。
#===============================================================================
if [ -r /proc/uptime ]; then
    uptime_secs=$(cut -d' ' -f1 /proc/uptime 2>/dev/null | cut -d. -f1)
    case "$uptime_secs" in
    '' | *[!0-9]*) uptime_secs=0 ;;
    esac
    if [ "$uptime_secs" -gt "$BOOT_WINDOW" ]; then
        logger -t "$LOGGER_TAG" "已开机 ${uptime_secs}s，超出开机窗口 ${BOOT_WINDOW}s，跳过恢复"
        exit 0
    fi
fi

if [ ! -x "$RESTORE_SCRIPT" ]; then
    logger -t "$LOGGER_TAG" "恢复脚本不可执行: $RESTORE_SCRIPT"
    exit 1
fi

LOG_DIR=$(dirname "$TRIGGER_LOG")
if ! mkdir -p "$LOG_DIR" 2>/dev/null || [ ! -d "$LOG_DIR" ]; then
    logger -t "$LOGGER_TAG" "无法创建日志目录 $LOG_DIR，回退到 /tmp"
    TRIGGER_LOG="/tmp/restore-packages-trigger.log"
fi

#===============================================================================
# 互斥锁：确保同一时间只有一个等待进程在运行
#===============================================================================
if ! exec 9>"$LOCKFILE" 2>/dev/null; then
    logger -t "$LOGGER_TAG" "无法创建锁文件，放弃互斥保护"
else
    if ! flock -n 9; then
        logger -t "$LOGGER_TAG" "已有等待进程在运行，退出"
        exit 0
    fi
fi

logger -t "$LOGGER_TAG" "WAN 接口上线，开始等待网络就绪..."

#===============================================================================
# 后台子进程：检测网络、调用恢复脚本
#===============================================================================
(
    waited=0
    while [ "$waited" -lt "$MAX_WAIT" ]; do
        if ping -c 1 -W 2 "$PING_TARGET" >/dev/null 2>&1; then
            logger -t "$LOGGER_TAG" "网络已就绪，启动恢复脚本: $RESTORE_SCRIPT"

            "$RESTORE_SCRIPT" >>"$TRIGGER_LOG" 2>&1
            exit_code=$?

            # 退出码语义（由 restore-packages.sh 保证）：
            #   0 = 完成（含「已处于二次失败终态，直接跳过」）
            #   1 = 仍有失败或环境不可用
            # 两种情况都【不在这里重启】：重启决策完全由恢复脚本按
            # attempt 状态自己做，且全生命周期最多一次。
            # 调度层不参与重启，从结构上杜绝重启循环。
            case "$exit_code" in
            0) logger -t "$LOGGER_TAG" "恢复脚本正常结束（退出码 0）" ;;
            1) logger -t "$LOGGER_TAG" "恢复脚本以退出码 1 结束：仍有失败包或环境不可用，不再重启，等待 LuCI 提示" ;;
            *) logger -t "$LOGGER_TAG" "恢复脚本异常结束（退出码 $exit_code）" ;;
            esac
            exit "$exit_code"
        fi

        sleep "$CHECK_INTERVAL"
        waited=$((waited + CHECK_INTERVAL))
    done

    logger -t "$LOGGER_TAG" "等待网络就绪超时 (已等待 ${MAX_WAIT} 秒)，放弃执行恢复脚本"
    exit 1
) &

#===============================================================================
# 父进程立即返回，避免阻塞 hotplug 后续事件处理
#===============================================================================
exit 0
