#!/bin/sh /etc/rc.common
#===============================================================================
# OpenWrt/ImmortalWrt init 脚本：fan-control
# 功能：管理智能 PWM 风扇控制守护进程的启动、停止和重载。
#       负责在服务启动前自动查找并设置 sysfs 接口权限，
#       并利用 procd 实现进程监护与自动重启。
#
# 用法：
#   /etc/init.d/fan-control {start|stop|restart|reload|enable|disable}
#
# 依赖：
#   - /usr/bin/fan-control.sh  智能风扇控制守护脚本
#   - procd (OpenWrt 进程管理)
#
# 配置：
#   本脚本不提供额外配置变量，所有风扇控制参数由
#   fan-control.sh 内部或环境变量决定。
#
# 说明：
#   - 启动顺序: START=99 (较晚启动，确保 sysfs 就绪)
#   - 停止顺序: STOP=10  (较早停止)
#   - 使用 procd 的 respawn 机制，守护进程崩溃后会自动重启。
#   - 停止服务时，守护脚本会通过 trap 自动恢复风扇自动模式，
#     因此无需额外安全速度设置。
#
# 作者：Shuery-Shuai
# 日期：2026-07-24
# 版本：1.2.0
#===============================================================================

# 以下变量由 rc.common 框架使用，ShellCheck 可能误报为未使用
# shellcheck disable=SC2034
START=99
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

PROG=/usr/bin/fan-control.sh

#===============================================================================
# 函数：find_and_setup_permissions
# 描述：自动扫描 /sys/class/hwmon 下所有设备，查找可能的 pwm1 和
#       temp1_input 文件，并将其权限设置为可读写（pwm）或可读（temp）。
#       这确保非 root 用户（如通过 procd 降权）也能访问硬件接口。
# 返回值：0 成功，1 未找到任何 PWM 设备
#===============================================================================
find_and_setup_permissions() {
    # shellcheck disable=SC3043  # ash 支持 local，忽略 POSIX 兼容性警告
    local hwmon
    # shellcheck disable=SC3043
    local found_pwm=0

    for hwmon in /sys/class/hwmon/hwmon*; do
        [ -d "$hwmon" ] || continue

        # 设置 PWM 文件权限
        if [ -w "$hwmon/pwm1" ]; then
            chmod 666 "$hwmon/pwm1" 2>/dev/null
            found_pwm=1
        fi
        # 设置 PWM 使能文件权限（如果存在）
        if [ -w "$hwmon/pwm1_enable" ]; then
            chmod 666 "$hwmon/pwm1_enable" 2>/dev/null
        fi
        # 设置温度输入文件为全局可读
        if [ -r "$hwmon/temp1_input" ]; then
            chmod 444 "$hwmon/temp1_input" 2>/dev/null
        fi
    done

    if [ "$found_pwm" -eq 0 ]; then
        echo "错误：未找到可写的 PWM 设备，无法启动风扇控制"
        return 1
    fi
    return 0
}

#===============================================================================
# 函数：start_service
# 描述：配置并启动风扇控制守护进程。首先调用权限设置函数，
#       然后通过 procd 注册服务实例，启用崩溃自动重启。
# 全局变量：PROG
#===============================================================================
start_service() {
    if ! find_and_setup_permissions; then
        echo "硬件权限初始化失败，放弃启动"
        return 1
    fi

    procd_open_instance
    procd_set_param command /bin/sh "$PROG"
    procd_set_param respawn
    # 3600 秒内最多重启 5 次，防止无限循环
    procd_set_param respawn_threshold 3600 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$PROG"
    procd_set_param pidfile /var/run/fan-control.pid
    procd_close_instance
}

#===============================================================================
# 函数：stop_service
# 描述：停止服务。procd 会向守护进程发送 TERM 信号，
#       守护脚本的 EXIT 陷阱会自动将风扇恢复为自动模式，
#       因此此处无需额外操作。
#===============================================================================
stop_service() {
    # 无需手动操作，fan-control.sh 的 trap 负责恢复自动控制
    return 0
}

#===============================================================================
# 函数：reload_service
# 描述：重载配置（通过重启服务实现）。
#===============================================================================
reload_service() {
    stop
    start
}

#===============================================================================
# 函数：restart
# 描述：重启服务。先停止（利用 trap 恢复自动模式），
#       然后重新启动。
#===============================================================================
restart() {
    stop
    start
}

#===============================================================================
# 函数：service_triggers
# 描述：注册 procd 重载触发器，响应 'fan-control' 配置变更。
#===============================================================================
service_triggers() {
    procd_add_reload_trigger "fan-control"
}
